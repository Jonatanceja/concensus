# Consensus Family: configuración de Apache (sustituye a netlify.toml)

DirectoryIndex index.html
AddDefaultCharset UTF-8
Options -Indexes

# Forzar HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Es un sitio de una sola página: cualquier ruta desconocida muestra la landing (con código 404)
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Los assets de Vite llevan hash en el nombre: se pueden cachear para siempre
    <FilesMatch "^.+\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(webp|jpe?g|png|svg|ico|pdf)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# Nunca servir archivos internos
<FilesMatch "^\.(?!well-known)|\.(yml|md|log)$">
    Require all denied
</FilesMatch>
